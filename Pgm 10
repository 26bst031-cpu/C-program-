#include <stdio.h>

/* No Argument, No Return */
void NANR()
{
    printf("NANR Function\n");
}

/* Argument, No Return */
void ANR(int a, int b)
{
    printf("ANR Sum = %d\n", a + b);
}

/* No Argument, With Return */
int NAWR()
{
    return 10 + 20;
}

/* Argument, With Return */
int AWR(int a, int b)
{
    return a + b;
}

int main()
{
    int result;

    NANR();

    ANR(10, 20);

    result = NAWR();
    printf("NAWR Sum = %d\n", result);

    result = AWR(30, 40);
    printf("AWR Sum = %d\n", result);

    return 0;
}
Output:
NANR Function
ANR Sum = 30
NAWR Sum = 30
AWR Sum = 70
